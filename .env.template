# ==============================================================================
# iAgentPay - Enterprise Infrastructure Configuration
# Copia este archivo como ".env" e inyecta tus llaves corporativas.
# ==============================================================================

# --- BASE DE DATOS (PostgreSQL) ---
# Si esta variable existe, el sistema automáticamente migrará de SQLite a PostgreSQL
# para manejar operaciones masivas.
# Ejemplo: postgres://usuario:password@localhost:5432/iagentpay_db
DATABASE_URL=

# --- NODOS RPC PRIVADOS ---
# Utiliza proveedores profesionales (Alchemy, Infura, Helius) para evitar baneos
# por Rate Limit. Si están en blanco, el SDK usará nodos públicos con backoff.
ETH_RPC_URL=
SOLANA_RPC_URL=

# --- SISTEMA DE ALERTAS (Discord / Telegram) ---
# Webhook de Discord donde recibirás notificaciones en tiempo real sobre
# ataques DDoS, validación humana pendiente y caídas de nodos.
DISCORD_WEBHOOK_URL=

# (Opcional) Token y Chat ID para Telegram si prefieres ese canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SEGURIDAD Y RESPALDOS (Disaster Recovery) ---
# Llave AES-256 para el cifrado de respaldos de PostgreSQL.
BACKUP_ENCRYPTION_KEY=iAgentPay-Enterprise-Secure-Key-2026
